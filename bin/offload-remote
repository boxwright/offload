#!/bin/bash
# offload-remote — run the offload command on the box that hosts the daemon, over SSH.
# The box is OFFLOAD_HOST, else the one line in ~/.config/offload/host. Symlink this as `offload` on a laptop that
# does not host the daemon.
HOST="${OFFLOAD_HOST:-$(cat "$HOME/.config/offload/host" 2>/dev/null)}"
[ -n "$HOST" ] || { echo "offload: set OFFLOAD_HOST, or write the SSH name of the box to ~/.config/offload/host" >&2; exit 2; }
if [ "$1" = "log" ]; then exec ssh -t "$HOST" 'journalctl --user -u offload.service -n 40 --no-pager -o cat'; fi
exec ssh "$HOST" "PATH=\$HOME/.local/bin:\$PATH offload $(printf '%q ' "$@")"
